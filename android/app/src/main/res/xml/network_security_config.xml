<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The Selfdrop server is a plain-HTTP LAN service. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
